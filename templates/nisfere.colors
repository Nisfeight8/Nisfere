{# Auto-generated by Nisfere ThemeManager — do not edit manually
   Target: ~/.config/qtengine/nisfere.colors
   Used by: qtengine (QT_QPA_PLATFORMTHEME=qtengine)
   Format: KColorScheme — all color values are R,G,B (not hex!) #}

[ColorEffects:Disabled]
ColorAmount=0
ColorEffect=0
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

[ColorEffects:Inactive]
ChangeSelectionColor=true
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

[Colors:Button]
BackgroundAlternate={{borderColor|rgb}}
BackgroundNormal={{backgroundAlt|rgb}}
DecorationFocus={{color5|rgb}}
DecorationHover={{color5|rgb}}
ForegroundActive={{color5|rgb}}
ForegroundInactive={{color8|rgb}}
ForegroundLink={{color4|rgb}}
ForegroundNegative={{color1|rgb}}
ForegroundNeutral={{color3|rgb}}
ForegroundNormal={{foreground|rgb}}
ForegroundPositive={{color2|rgb}}
ForegroundVisited={{color13|rgb}}

[Colors:Selection]
BackgroundAlternate={{color5|darken(0.15)|rgb}}
BackgroundNormal={{color5|rgb}}
DecorationFocus={{color5|rgb}}
DecorationHover={{color5|rgb}}
ForegroundActive={{background|rgb}}
ForegroundInactive={{background|rgb}}
ForegroundLink={{background|rgb}}
ForegroundNegative={{color1|rgb}}
ForegroundNeutral={{color3|rgb}}
ForegroundNormal={{background|rgb}}
ForegroundPositive={{color2|rgb}}
ForegroundVisited={{background|rgb}}

