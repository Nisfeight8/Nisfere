[General]
ColorScheme=NisfereDark
Name=Nisfere Dark
shadeSortColumn=true

[KDE]
contrast=4

[WM]
activeBackground={{background|rgb}}
activeBlend={{color5|rgb}}
activeForeground={{foreground|rgb}}
inactiveBackground={{background|darken(0.05)|rgb}}
inactiveBlend={{background|rgb}}
inactiveForeground={{color8|rgb}}
